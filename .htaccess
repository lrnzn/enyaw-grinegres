Options -Indexes
DirectoryIndex index.php

# On a live site with HTTPS, uncomment these two lines to force secure connections:
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# Never serve these directly
<FilesMatch "\.(sql|md|ini|example\.php)$">
  Require all denied
</FilesMatch>

# Let browsers keep fonts, images, styles and scripts so pages do not reload them on every click.
# (style.css and app.js carry ?v= in their address, so a new version still loads at once.)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|css|js|png|jpe?g|svg)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
